<script>

/* =========================================
   YOUR WHATSAPP NUMBER
========================================= */

const whatsappNumber = "919989665938";


/* =========================================
   PRICE TABLE
   SIZE + PRINT QUALITY
========================================= */

const prices = {

  "4x6":{
    "Standard Print":149,
    "HD Print":179,
    "Premium Photo Print":199
  },

  "6x8":{
    "Standard Print":199,
    "HD Print":229,
    "Premium Photo Print":259
  },

  "8x10":{
    "Standard Print":299,
    "HD Print":349,
    "Premium Photo Print":399
  },

  "10x12":{
    "Standard Print":399,
    "HD Print":449,
    "Premium Photo Print":499
  },

  "12x18":{
    "Standard Print":499,
    "HD Print":599,
    "Premium Photo Print":699
  },

  "16x20":{
    "Standard Print":699,
    "HD Print":799,
    "Premium Photo Print":899
  }

};


/* CURRENT SELECTION */

let selectedSize = "4x6";

let selectedQuality = "Standard Print";

let quantity = 1;


/* =========================================
   PAGE NAVIGATION
========================================= */

function showPage(pageId,button){

  document.querySelectorAll(".page")
    .forEach(page=>{
      page.classList.remove("active");
    });

  document.getElementById(pageId)
    .classList.add("active");

  document.querySelectorAll(".nav-item")
    .forEach(item=>{
      item.classList.remove("active");
    });

  if(button){
    button.classList.add("active");
  }

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* =========================================
   ORDER PAGE
========================================= */

function openOrder(){

  showPage(
    "orderPage",
    document.querySelectorAll(".nav-item")[2]
  );

}


/* =========================================
   SELECT SIZE
========================================= */

function selectSizeAndOrder(size){

  selectedSize = size;

  openOrder();

  document.querySelectorAll(".size-choice")
    .forEach(choice=>{

      choice.classList.remove("active");

      if(choice.dataset.size===size){
        choice.classList.add("active");
      }

    });

  updateSummary();

}


function chooseSize(element){

  document.querySelectorAll(".size-choice")
    .forEach(item=>{
      item.classList.remove("active");
    });

  element.classList.add("active");

  selectedSize = element.dataset.size;

  updateSummary();

}


/* =========================================
   QUALITY
========================================= */

function chooseQuality(element){

  document.querySelectorAll(".quality-choice")
    .forEach(item=>{
      item.classList.remove("active");
    });

  element.classList.add("active");

  selectedQuality = element.dataset.quality;

  updateSummary();

}


/* =========================================
   QUANTITY
========================================= */

function changeQuantity(change){

  quantity += change;

  if(quantity<1){
    quantity=1;
  }

  if(quantity>20){
    quantity=20;
  }

  document.getElementById("quantity")
    .value=quantity;

  updateSummary();

}


/* =========================================
   PHOTO PREVIEW
========================================= */

document.getElementById("photo")
.addEventListener("change",function(){

  const file=this.files[0];

  if(!file){
    return;
  }

  if(!file.type.startsWith("image/")){

    alert("Please select an image.");

    this.value="";

    return;
  }

  const reader=new FileReader();

  reader.onload=function(event){

    document.getElementById("previewImage")
      .src=event.target.result;

    document.getElementById("preview")
      .style.display="block";

  };

  reader.readAsDataURL(file);

});


/* =========================================
   UPDATE PRICE
========================================= */

function updateSummary(){

  const price=
    prices[selectedSize][selectedQuality];

  const delivery=
    Number(
      document.getElementById("delivery").value
    );

  const frameTotal=
    price*quantity;

  const total=
    frameTotal+delivery;


  document.getElementById("summarySize")
    .textContent=formatSize(selectedSize);

  document.getElementById("summaryQuality")
    .textContent=shortQuality(selectedQuality);

  document.getElementById("summaryPrice")
    .textContent="₹"+price;

  document.getElementById("summaryQuantity")
    .textContent=quantity;

  document.getElementById("summaryDelivery")
    .textContent=
      delivery===0
      ?"Free"
      :"₹"+delivery;

  document.getElementById("total")
    .textContent="₹"+total;

}


function formatSize(size){

  return size.replace("x"," × ");

}


function shortQuality(quality){

  if(quality==="Standard Print"){
    return "Standard";
  }

  if(quality==="HD Print"){
    return "HD";
  }

  return "Premium";

}


/* =========================================
   SEARCH
========================================= */

function searchFrames(value){

  const search=
    value.toLowerCase().trim();

  const results=
    document.getElementById("searchResults");

  if(!results){
    return;
  }


  const sizes=[
    "4x6",
    "6x8",
    "8x10",
    "10x12",
    "12x18",
    "16x20"
  ];


  const matches=
    sizes.filter(size=>
      size.includes(search)
    );


  if(search===""){

    results.innerHTML=`
      <div class="card no-results">
        🔍 Search for a frame size above.
      </div>
    `;

    return;
  }


  if(matches.length===0){

    results.innerHTML=`
      <div class="card no-results">
        😔 No frames found.
      </div>
    `;

    return;
  }


  results.innerHTML=
    matches.map(size=>{

      const price=
        prices[size]["Standard Print"];

      return `

        <div class="product" style="margin-bottom:12px;">

          <div class="product-image">
            <div class="frame-placeholder">
              🖼️
            </div>
          </div>

          <h3>
            ${formatSize(size)} inch
          </h3>

          <p>
            Standard / HD / Premium
          </p>

          <div class="price">
            Starting ₹${price}
          </div>

          <button
            onclick="selectSizeAndOrder('${size}')"
          >
            Order Now
          </button>

        </div>

      `;

    }).join("");

}


