<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MM Photo Frames | Custom Photo Frames</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f4f6f8;
  color:#171717;
  padding-bottom:75px;
}

/* HEADER */
header{
  background:#111827;
  color:white;
  padding:15px;
  position:sticky;
  top:0;
  z-index:50;
}

.header-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:20px;
  font-weight:bold;
}

.header-icon{
  font-size:24px;
}

.search-bar{
  margin-top:12px;
  background:white;
  border-radius:12px;
  display:flex;
  align-items:center;
  padding:11px 13px;
}

.search-bar span{
  font-size:21px;
  margin-right:8px;
}

.search-bar input{
  border:0;
  outline:0;
  width:100%;
  font-size:15px;
}

/* PAGE */
.page{
  display:none;
  max-width:900px;
  margin:auto;
  padding:15px;
}

.page.active{
  display:block;
}

/* HERO */
.hero{
  background:linear-gradient(135deg,#111827,#374151);
  color:white;
  border-radius:18px;
  padding:25px 20px;
  margin-bottom:18px;
}

.hero h1{
  font-size:28px;
  margin-bottom:8px;
}

.hero p{
  color:#e5e7eb;
  line-height:1.5;
}

.hero button{
  margin-top:17px;
  padding:13px 20px;
  border:0;
  border-radius:10px;
  background:white;
  color:#111827;
  font-weight:bold;
}

/* CATEGORY */
.categories{
  display:flex;
  gap:10px;
  overflow-x:auto;
  padding:5px 0 15px;
}

.category{
  min-width:95px;
  background:white;
  border-radius:12px;
  padding:13px 8px;
  text-align:center;
  border:1px solid #ddd;
}

.category-icon{
  font-size:28px;
  margin-bottom:5px;
}

.category small{
  font-weight:bold;
}

/* PRODUCTS */
.section-title{
  font-size:21px;
  margin:12px 0;
}

.products{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.product{
  background:white;
  border-radius:15px;
  padding:12px;
  box-shadow:0 3px 12px rgba(0,0,0,.07);
}

.product-image{
  height:150px;
  border-radius:12px;
  background:#eee;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  margin-bottom:10px;
}

.product-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.frame-placeholder{
  font-size:65px;
}

.product h3{
  font-size:16px;
  margin-bottom:5px;
}

.product p{
  color:#666;
  font-size:13px;
}

.price{
  margin-top:8px;
  font-size:18px;
  font-weight:bold;
}

.product button{
  width:100%;
  margin-top:10px;
  padding:11px;
  border:0;
  border-radius:9px;
  background:#111827;
  color:white;
  font-weight:bold;
}

/* CARD */
.card{
  background:white;
  border-radius:16px;
  padding:19px;
  margin-bottom:16px;
  box-shadow:0 3px 15px rgba(0,0,0,.06);
}

.card h2{
  margin-bottom:15px;
  font-size:20px;
}

label{
  display:block;
  font-weight:bold;
  margin:13px 0 7px;
}

input,
select,
textarea{
  width:100%;
  padding:13px;
  border:1px solid #d1d5db;
  border-radius:10px;
  font-size:15px;
  outline:none;
}

textarea{
  min-height:90px;
  resize:vertical;
}

/* CHOICES */
.size-grid,
.quality-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.choice{
  border:2px solid #ddd;
  border-radius:12px;
  padding:15px 10px;
  text-align:center;
  cursor:pointer;
  background:white;
}

.choice.active{
  border-color:#111827;
  background:#f3f4f6;
}

.choice strong{
  display:block;
  font-size:16px;
}

.choice small{
  display:block;
  color:#666;
  margin-top:5px;
}

/* UPLOAD */
.upload{
  border:2px dashed #aaa;
  border-radius:13px;
  padding:22px;
  text-align:center;
  background:#fafafa;
}

.preview{
  display:none;
  text-align:center;
  margin-top:15px;
}

.preview img{
  max-width:260px;
  max-height:260px;
  border-radius:12px;
  border:5px solid #222;
}

/* QUANTITY */
.quantity{
  display:flex;
  align-items:center;
  gap:12px;
}

.quantity button{
  width:43px;
  height:43px;
  border:0;
  border-radius:9px;
  background:#111827;
  color:white;
  font-size:23px;
}

.quantity input{
  width:70px;
  text-align:center;
}

/* SUMMARY */
.summary{
  background:#111827;
  color:white;
  border-radius:16px;
  padding:20px;
}

.summary-row{
  display:flex;
  justify-content:space-between;
  padding:8px 0;
}

.total{
  border-top:1px solid #555;
  margin-top:8px;
  padding-top:15px;
  font-size:24px;
  font-weight:bold;
}

.order-button{
  width:100%;
  margin-top:18px;
  padding:16px;
  border:0;
  border-radius:11px;
  background:#25D366;
  color:white;
  font-size:17px;
  font-weight:bold;
}

/* INFO */
.info{
  background:#fff7ed;
  border-left:4px solid #f97316;
  padding:12px;
  margin-top:13px;
  font-size:13px;
  line-height:1.5;
}

/* CONFIRMATION */
.confirmation{
  display:none;
  background:#ecfdf5;
  border:2px solid #22c55e;
  color:#166534;
  border-radius:15px;
  padding:20px;
  margin-bottom:16px;
}

/* SEARCH */
.no-results{
  text-align:center;
  padding:30px;
  color:#777;
}

/* ACCOUNT */
.account-box{
  text-align:center;
  padding:30px;
}

.account-icon{
  font-size:55px;
  margin-bottom:10px;
}

/* BOTTOM NAV */
.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:70px;
  background:white;
  border-top:1px solid #ddd;
  display:flex;
  justify-content:space-around;
  align-items:center;
  z-index:100;
}

.nav-item{
  border:0;
  background:none;
  color:#666;
  font-size:12px;
  text-align:center;
}

.nav-item div{
  font-size:23px;
  margin-bottom:3px;
}

.nav-item.active{
  color:#111827;
  font-weight:bold;
}

/* FOOTER */
footer{
  text-align:center;
  padding:25px;
  color:#777;
}

/* MOBILE */
@media(max-width:500px){

  .products{
    grid-template-columns:1fr 1fr;
  }

  .product-image{
    height:125px;
  }

  .hero h1{
    font-size:25px;
  }
}

@media(max-width:360px){

  .products,
  .size-grid,
  .quality-grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>

